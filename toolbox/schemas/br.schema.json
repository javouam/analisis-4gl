{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "additionalProperties": false,
 "properties": {
  "rules": {
   "items": {
    "properties": {
     "domain": {
      "type": "string"
     },
     "evidence": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "file": {
         "type": "string"
        },
        "line": {
         "type": "integer"
        }
       },
       "required": [
        "file"
       ],
       "type": "object"
      },
      "minItems": 1,
      "type": "array"
     },
     "id": {
      "type": "string"
     },
     "statement": {
      "type": "string"
     },
     "status": {
      "enum": [
       "confirmed",
       "inferred",
       "pending"
      ]
     }
    },
    "required": [
     "id",
     "domain",
     "statement",
     "status",
     "evidence"
    ],
    "type": "object"
   },
   "type": "array"
  }
 },
 "required": [
  "rules"
 ],
 "title": "business rule facts",
 "type": "object"
}
