{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "additionalProperties": false,
 "properties": {
  "items": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "component": {
      "type": "string"
     },
     "evidence": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "file": {
         "type": "string"
        },
        "line": {
         "type": "integer"
        }
       },
       "required": [
        "file"
       ],
       "type": "object"
      },
      "minItems": 1,
      "type": "array"
     },
     "fix": {
      "type": [
       "string",
       "null"
      ]
     },
     "id": {
      "type": "string"
     },
     "severity": {
      "enum": [
       "CRITICAL",
       "HIGH",
       "MEDIUM",
       "LOW",
       "UNKNOWN"
      ]
     },
     "sources": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "title": {
      "type": "string"
     },
     "version": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "severity",
     "component"
    ],
    "type": "object"
   },
   "type": "array"
  }
 },
 "required": [
  "items"
 ],
 "title": "vulnerability facts",
 "type": "object"
}
